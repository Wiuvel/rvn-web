{
  "name": "rvn-web",
  "version": "0.1.0",
  "description": "RVN — VPN & Proxy platform",
  "type": "module",
  "keywords": [
    "rvn",
    "vpn",
    "proxy",
    "vless",
    "nextjs",
    "react",
    "typescript",
    "trpc",
    "drizzle",
    "redis",
    "websocket",
    "wasm"
  ],
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vinext dev -H 127.0.0.1",
    "build": "vinext build",
    "build:wasm": "cd wasm && wasm-pack build --target web --out-dir ../lib/wasm/pkg",
    "start": "vinext start",
    "lint": "oxlint",
    "test": "vitest",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "type:check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/query-async-storage-persister": "^5.100.5",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "maxmind": "^5.0.6",
    "ogl": "^1.0.11",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "thumbhash": "^0.1.1",
    "vinext": "^0.0.45",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.25",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.0",
    "oxlint": "^1.62.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react-server-dom-webpack": "^19.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "typescript": "^6.0.3"
    },
    "ignoredBuiltDependencies": [
      "@swc/core"
    ]
  }
}
