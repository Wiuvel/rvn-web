{
  "name": "rvn-web",
  "version": "0.1.0",
  "description": "Secure, high-performance VPN & Proxy (VLESS) platform for a clean internet without limits",
  "keywords": [
    "rvn",
    "vpn",
    "proxy",
    "vless",
    "nextjs",
    "react",
    "typescript",
    "trpc",
    "drizzle",
    "redis",
    "websocket",
    "wasm"
  ],
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:wasm": "cd wasm && wasm-pack build --target nodejs --out-dir ../lib/wasm/pkg",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/query-async-storage-persister": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.8.0",
    "maxmind": "^5.0.6",
    "next": "16.2.3",
    "ogl": "^1.0.11",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "thumbhash": "^0.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.2",
    "oxlint": "^1.60.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "fast-xml-parser": "5.5.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
